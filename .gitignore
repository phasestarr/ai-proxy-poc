# Purpose:
# - Prevent local-only files, secrets, build outputs, caches, and IDE metadata
#   from being committed to the repository.

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
*.iml

# Local environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/

# Logs and runtime files
*.log
*.pid

# Secrets
secrets/*
!secrets/README.md
*.crt
*.key
*.pem
*.p12
*.pfx
gcp-service-account.json

# Build artifacts
build/
coverage/
